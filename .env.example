# --- Konfigurasi Railway (Paling direkomendasikan untuk Vercel) ---
# Salin Connection URL (Public atau Private) dari Railway MySQL
DATABASE_URL=mysql://root:PASSWORD@HOST:PORT/railway

# --- Atau jika menggunakan variabel terpisah ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=kasir_mainan
# DB_SSL=false

# --- JWT Secret untuk autentikasi ---
JWT_SECRET=buat-teks-rahasia-acak-panjang-disini-minimal-32-karakter
